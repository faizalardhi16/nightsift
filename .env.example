# =========================================================
# Night Shift environment configuration
# Copy to .env and fill in values
# =========================================================

# --- Database ---
DATABASE_URL=

# --- Azure OpenAI (Deepseek-V4-Flash) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=

# --- Git Provider ---
# self-hosted GitLab (git.dexagroup.com)
GITLAB_URL=
GITLAB_TOKEN=

# github.com
GITHUB_TOKEN=

# --- Ace (MCP Task Provider) ---
ACE_MCP_ENABLED=false
ACE_BASE_URL=
ACE_API_KEY=
ACE_GATEWAY_API_KEY=

# --- Workflow ---
MAX_ACTIVE_CODING_TASKS=1
MAX_REPAIR_ATTEMPTS=3
READINESS_THRESHOLD=90
WORKSPACE_ROOT=/workspaces
REPOSITORY_ROOT=/repos

# --- Coding Agents ---
DEFAULT_CODING_AGENT=codex
CODING_TIMEOUT_SECONDS=3600

# --- Logging ---
LOG_LEVEL=INFO
